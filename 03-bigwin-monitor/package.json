{
  "name": "bigwin-monitor",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "login": "node src/index.js login",
    "run-once": "node src/index.js run-once",
    "dry": "node src/index.js run-once --dry",
